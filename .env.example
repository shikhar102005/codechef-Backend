# Seat Reservation System Environment Configuration Example
# Copy this file to .env and adjust variables as required

# Server
PORT=8081
GIN_MODE=release

# Database (PostgreSQL or Supabase)
# For local Docker: postgres://postgres:postgrespassword@localhost:5432/seat_booking_db?sslmode=disable
# For Supabase direct: postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# For Supabase pooler (transaction mode): postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/seat_booking_db?sslmode=disable

# Cache & Rate Limiting (Redis)
# Leave empty or set to "none" for integrated resilient in-memory fallback
REDIS_URL=redis://localhost:6379

# Messaging & Outbox (RabbitMQ)
# Leave empty or set to "none" for integrated resilient in-process bus
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Authentication
JWT_SECRET=development-super-secret-jwt-key-minimum-32-bytes

# Admission Control & Waiting Queue
ADMISSION_MAX_CONCURRENCY=100
ADMISSION_QUEUE_CAPACITY=500
ADMISSION_TIMEOUT_SECONDS=5
